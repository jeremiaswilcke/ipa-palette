<?xml version="1.0" encoding="utf-8"?>
<!-- IPA-Palette als MSIX für den Microsoft Store. Platzhalter füllt windows/build-msix.sh aus windows/msix/store.env. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64"/>

  <Properties>
    <DisplayName>IPA-Palette</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Symbole des Internationalen Phonetischen Alphabets per Klick in jedes Programm einfügen.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>

  <Resources>
    <Resource Language="de-DE"/>
  </Resources>

  <Applications>
    <Application Id="IPAPalette" Executable="IPA-Palette.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="IPA-Palette" Description="IPA-Symbole per Klick in jedes Programm einfügen"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="IPA-Palette.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="IPAPaletteStartup" Enabled="false" DisplayName="IPA-Palette"/>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
</Package>
